---
/**
 * An element tile: atomic number, mass, symbol, name (brief 2.6, 3).
 * The Cu tile is the primary mark. Symbols are copper, the single accent;
 * only the Cu tile gets a copper frame.
 */
interface Props {
  symbol: string;
  name: string;
  number: number | string;
  mass: string;
  href?: string;
  mark?: boolean; // the Cu mark: copper frame
  label?: string;
}

const { symbol, name, number, mass, href, mark = false, label } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['tile', { 'tile--mark': mark }]}
  href={href}
  role={href ? undefined : 'img'}
  aria-label={label ?? `${name}, ${symbol}, ${number}`}
>
  <span class="tile__meta" aria-hidden="true"><span>{number}</span><span>{mass}</span></span>
  <span class:list={['tile__symbol', { 'tile__symbol--long': symbol.length > 2 }]} aria-hidden="true">{symbol}</span>
  <span class="tile__name" aria-hidden="true">{name}</span>
</Tag>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 1;
    width: 9rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--hairline-strong);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--paper);
  }
  .tile--mark { border-color: var(--copper); }
  a.tile:hover { border-color: var(--copper-hover); color: var(--paper); }
  .tile__meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    color: var(--label);
  }
  .tile__symbol {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 3.25rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--copper);
  }
  .tile__symbol--long { font-size: 2.4rem; }
  .tile__name { font-size: 0.6875rem; color: var(--text-muted); text-transform: lowercase; }

  @media (max-width: 34rem) {
    .tile { width: 5.75rem; padding: 0.5rem; }
    .tile__meta, .tile__name { font-size: 0.5625rem; }
    .tile__symbol { font-size: 2.1rem; }
    .tile__symbol--long { font-size: 1.5rem; }
  }
</style>

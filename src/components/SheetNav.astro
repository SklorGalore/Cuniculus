---
/** Top navigation: the wordmark and lowercase mono links (brief 2.0, 2.5). */
import Wordmark from './Wordmark.astro';
import { sheets } from '../data/sheets';

interface Props { current: string }
const { current } = Astro.props;
const order = ['02', '01', '03', '04']; // work, services, notes, about
const links = order.map((n) => sheets.find((s) => s.number === n)!);
---

<header class="nav">
  <a class="nav__brand" href="/" aria-label="Cuniculus, home">
    <Wordmark />
  </a>
  <nav aria-label="Main">
    <ul role="list">
      {links.map((s) => (
        <li>
          <a href={s.href} aria-current={s.number === current ? 'page' : undefined}>{s.nav}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding: 3rem 0 0;
  }
  .nav__brand:hover :global(.wordmark) { color: var(--paper); }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2.25rem;
  }
  a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--label);
  }
  ul a:hover { color: var(--copper-hover); }
  a[aria-current='page'] { color: var(--paper); }

  @media (max-width: 34rem) {
    .nav { padding-top: 1.75rem; }
    ul { gap: 0.25rem 1.25rem; }
  }
</style>

---
/**
 * Drawing-sheet title block (brief section 2.2), at the foot of every page.
 */
import { lastSheet } from '../data/sheets';

interface Props {
  title: string;
  sheet: string;
  rev: string;
  date: string;
}
const { title, sheet, rev, date } = Astro.props;
---

<table class="tblock">
  <caption class="visually-hidden">Title block</caption>
  <tbody>
    <tr>
      <td colspan="3" class="tblock__title">
        <span class="label">Drawing title</span>
        <span class="tblock__name">{title}</span>
      </td>
      <td class="tblock__mark"><a href="/" aria-label="Cuniculus home">Cu</a></td>
    </tr>
    <tr>
      <td><span class="label">Sheet</span><span class="mono">{sheet} OF {lastSheet}</span></td>
      <td><span class="label">Rev</span><span class="mono">{rev}</span></td>
      <td><span class="label">Date</span><time class="mono" datetime={date}>{date}</time></td>
      <td><span class="label">Drawn</span><span class="mono">S. COELHO</span></td>
    </tr>
  </tbody>
</table>

<style>
  .tblock {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    color: var(--vellum);
  }
  td {
    border: 1px solid var(--tin);
    padding: 0.55rem 0.8rem 0.6rem;
    vertical-align: top;
  }
  td .label { display: block; font-size: 0.625rem; margin-bottom: 0.2rem; }
  td .mono { font-size: 0.875rem; }
  .tblock__name {
    display: block;
    font-family: var(--font-inscription);
    font-size: 1.25rem;
    letter-spacing: 0.04em;
  }
  .tblock__mark {
    text-align: center;
    vertical-align: middle;
    font-family: var(--font-inscription);
    font-size: 1.75rem;
  }
  .tblock__mark a { color: var(--copper); text-decoration: none; }

  @media (max-width: 34rem) {
    td { padding: 0.45rem 0.5rem; }
    td .mono { font-size: 0.75rem; }
    .tblock__name { font-size: 1rem; }
  }
</style>

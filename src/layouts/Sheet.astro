---
/**
 * Every page is a drawing sheet (brief section 2.2):
 * navigation on top, the sheet strip at the foot.
 */
import '../styles/global.css';
import SheetNav from '../components/SheetNav.astro';
import SheetStrip from '../components/SheetStrip.astro';
import { sheetFor } from '../data/sheets';

interface Props {
  /** Sheet number from src/data/sheets.ts, e.g. "00". */
  sheet: string;
  /** Drawing title; defaults to the sheet title. */
  title?: string;
  rev?: string;
  date?: string;
  description?: string;
}

const s = sheetFor(Astro.props.sheet);
const title = Astro.props.title ?? s.title;
const rev = Astro.props.rev ?? s.rev;
const date = Astro.props.date ?? s.date;
const description =
  Astro.props.description ?? 'Cuniculus: power systems engineering, built like infrastructure.';
const pageTitle = s.number === '00' && !Astro.props.title ? 'Cuniculus' : `${title} · Cuniculus`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111213" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
  </head>
  <body>
    <div class="sheet">
      <SheetNav current={s.number} />
      <main id="main">
        <slot />
      </main>
      <SheetStrip title={title} sheet={s.number} rev={rev} date={date} />
    </div>
  </body>
</html>

<style>
  .sheet {
    max-width: var(--sheet-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main { flex: 1; padding: clamp(4rem, 9vw, 7.5rem) 0 5rem; }
</style>

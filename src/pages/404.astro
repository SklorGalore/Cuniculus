---
import Sheet from '../layouts/Sheet.astro';
import RabbitGlyph from '../components/RabbitGlyph.astro';
---

<Sheet sheet="00" title="Wrong tunnel" description="This tunnel doesn't go anywhere.">
  <p class="label">404</p>
  <h1>Wrong tunnel.</h1>
  <p class="body">
    This channel was never dug, or it has caved in. Head back to the <a href="/">index</a>.
  </p>
  <p class="ears"><RabbitGlyph size={40} title="A rabbit, drawn as two busbars" /></p>
</Sheet>

<style>
  h1 { font-size: clamp(2.25rem, 5vw, 3.75rem); margin: 0.75rem 0 1.5rem; }
  .body { color: var(--text-muted); max-width: 32rem; }
  .body a { color: var(--copper); }
  .body a:hover { color: var(--copper-hover); }
  .ears { margin-top: 3rem; }
</style>

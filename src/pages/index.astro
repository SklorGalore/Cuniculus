---
import Sheet from '../layouts/Sheet.astro';
import ConvergencePlot from '../components/ConvergencePlot.astro';
import WorkIndex from '../components/WorkIndex.astro';
---

<Sheet sheet="00">
  <section class="hero" aria-labelledby="statement">
    <div class="hero__text">
      <h1 id="statement">Power systems engineering, built like infrastructure.</h1>
      <p class="lede">Transmission planning studies, automation, and the software behind them, by Skylar Coelho.</p>
    </div>
    <div class="hero__fig">
      <ConvergencePlot />
    </div>
  </section>

  <WorkIndex />
</Sheet>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: 3rem;
    align-items: end;
    margin-bottom: clamp(4rem, 8vw, 6.5rem);
  }
  .hero__text { grid-column: span 7; display: grid; gap: 1.75rem; }
  .hero__fig { grid-column: 9 / span 4; }
  h1 { font-size: clamp(2.25rem, 4.6vw, 3.75rem); line-height: 1.08; }
  .lede { margin: 0; max-width: 35rem; font-size: 1.125rem; color: var(--text-muted); }

  @media (max-width: 60rem) {
    .hero__text, .hero__fig { grid-column: 1 / -1; }
    .hero__fig { max-width: 28rem; }
  }
</style>

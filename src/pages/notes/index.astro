---
import Sheet from '../../layouts/Sheet.astro';
import BusRule from '../../components/BusRule.astro';
---

<Sheet sheet="03">
  <header class="head">
    <p class="label">03 · notes</p>
    <h1>Writing and technical deep dives.</h1>
  </header>
  <BusRule />
  <p class="note label">This sheet is in preparation.</p>
</Sheet>

<style>
  .head { display: grid; gap: 1.25rem; margin-bottom: 4rem; }
  .head .label { margin: 0; }
  h1 { font-size: clamp(2rem, 4vw, 3rem); max-width: 44rem; }
  .note { margin-top: 1.5rem; }
</style>
